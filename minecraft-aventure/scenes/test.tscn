[sub_resource type="GDScript" id="GDScript_jjgoa"]
script/source = "extends Area3D

@onready var requirement: NfcRequirement = $NfcRequirement
var text: String
@export var shot_name := \"PuertaCloseup\"
@export var return_on_exit := true

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	requirement.completed.connect(_on_requirement_completed)
	requirement.rejected.connect(_on_requirement_rejected)
	


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass

func _on_requirement_completed(item: Dictionary, reader_id: int) -> void:
	pass


func _on_requirement_rejected(item: Dictionary, reader_id: int) -> void:
	text = \"✗ No coincide: %s, lector %d.\" % [item.get(\"id\", \"\"), reader_id]

func _on_body_entered(body: Node3D) -> void:
	if body.is_in_group(\"player\"):
		print(\"test1\")
		TestScene.current.switch_to_shot(shot_name)
		requirement.set_active(true)
		print(text)


func _on_body_exited(body: Node3D) -> void:
	if body.is_in_group(\"player\"):
		requirement.set_active(false)	#si saco esta linea, me permite quedar esperando la entrada correspondiente del lector
		print(text)
		TestScene.current.return_to_player()


func _on_nfc_requirement_completed(item: Dictionary, reader_id: int) -> void:
	var i = requirement.required_item_id
	text = requirement._item_name_from_catalog(i)
	print(text)
"

